@model IEnumerable<Prova2.Web.Models.LogItemDto>

@{
    ViewData["Title"] = "Logs de Auditoria";
    var entidadeAtual = ViewData["EntidadeAtual"]?.ToString() ?? "";
    var acaoAtual = ViewData["AcaoAtual"]?.ToString() ?? "";
    var origemAtual = ViewData["OrigemAtual"]?.ToString() ?? "";
    var buscaAtual = ViewData["BuscaAtual"]?.ToString() ?? "";
}

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div>
                <h5 class="card-title mb-1 text-secondary fw-bold">Histórico de Atividades do Sistema</h5>
                <p class="text-muted small mb-0">Registro unificado de acessos, cadastros, edições, mudanças de status e exclusões.</p>
            </div>
            <a asp-action="ExportarCsv"
               asp-route-entidade="@entidadeAtual"
               asp-route-acao="@acaoAtual"
               asp-route-origem="@origemAtual"
               asp-route-busca="@buscaAtual"
               download
               class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2">
                <i class="bi bi-file-earmark-spreadsheet"></i>
                <span>Exportar CSV</span>
            </a>
        </div>

        <form asp-action="Index" method="get" class="row g-2 mb-4">
            <div class="col-md-4">
                <input type="text" name="busca" value="@buscaAtual" class="form-control" placeholder="Buscar por usuário ou detalhes..." />
            </div>
            <div class="col-md-2">
                <select name="entidade" class="form-select">
                    <option value="" selected="@(entidadeAtual == "")">Entidade (Todas)</option>
                    <option value="Sessao" selected="@(entidadeAtual == "Sessao")">Sessão / Login</option>
                    <option value="Produto" selected="@(entidadeAtual == "Produto")">Produto</option>
                    <option value="Usuario" selected="@(entidadeAtual == "Usuario")">Usuário</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="acao" class="form-select">
                    <option value="" selected="@(acaoAtual == "")">Ação (Todas)</option>
                    <option value="LOGIN_SUCESSO" selected="@(acaoAtual == "LOGIN_SUCESSO")">Login Sucesso</option>
                    <option value="LOGIN_FALHA" selected="@(acaoAtual == "LOGIN_FALHA")">Login Falha</option>
                    <option value="LOGIN_BLOQUEADO" selected="@(acaoAtual == "LOGIN_BLOQUEADO")">Login Bloqueado</option>
                    <option value="CRIAR" selected="@(acaoAtual == "CRIAR")">Criar</option>
                    <option value="EDITAR" selected="@(acaoAtual == "EDITAR")">Editar</option>
                    <option value="ALTERAR_STATUS" selected="@(acaoAtual == "ALTERAR_STATUS")">Alterar Status</option>
                    <option value="EXCLUIR" selected="@(acaoAtual == "EXCLUIR")">Excluir</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="origem" class="form-select">
                    <option value="" selected="@(origemAtual == "")">Origem (Todas)</option>
                    <option value="WebSite" selected="@(origemAtual == "WebSite")">WebSite</option>
                    <option value="Desktop" selected="@(origemAtual == "Desktop")">Desktop</option>
                    <option value="API" selected="@(origemAtual == "API")">API</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-funnel"></i></button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light text-secondary">
                    <tr>
                        <th style="width: 14%;">Data / Hora</th>
                        <th style="width: 14%;">Ação</th>
                        <th style="width: 11%;">Entidade</th>
                        <th style="width: 10%;">Origem</th>
                        <th style="width: 15%;">Responsável</th>
                        <th>Detalhes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                Nenhum evento encontrado para os filtros aplicados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var log in Model)
                        {
                            var badgeClass = log.Acao switch
                            {
                                "LOGIN_SUCESSO" or "CRIAR" => "bg-success bg-opacity-10 text-success border border-success",
                                "EDITAR" or "ALTERAR_STATUS" => "bg-warning bg-opacity-25 text-dark border border-warning",
                                "EXCLUIR" or "LOGIN_FALHA" or "LOGIN_BLOQUEADO" => "bg-danger bg-opacity-10 text-danger border border-danger",
                                _ => "bg-secondary bg-opacity-10 text-secondary border border-secondary"
                            };

                            <tr>
                                <td class="text-muted font-monospace">@log.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td><span class="badge @badgeClass px-2 py-1">@log.Acao</span></td>
                                <td class="fw-semibold text-dark">
                                    @log.Entidade
                                    @if (log.EntidadeId.HasValue)
                                    {
                                        <span class="text-muted">#@log.EntidadeId</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@log.Origem</span></td>
                                <td class="fw-semibold text-dark">@log.UsuarioResponsavel</td>
                                <td class="text-secondary">@log.Detalhes</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>