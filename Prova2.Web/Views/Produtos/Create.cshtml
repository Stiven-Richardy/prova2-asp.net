@model Prova2.Web.Models.ProdutoFormViewModel

@{
    ViewData["Title"] = "Cadastrar Novo Produto";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0" style="border-top: 4px solid #0A3D62 !important;">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="mb-0 fw-bold" style="color: #0A3D62;">
                    <i class="bi bi-plus-circle me-2"></i> Novo Produto
                </h5>
                <span class="text-muted small">O cadastro será vinculado automaticamente ao usuário autenticado (<strong>@User.Identity?.Name</strong>).</span>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-bold text-secondary"></label>
                        <input asp-for="Nome" class="form-control" placeholder="Ex: Teclado Mecânico RGB" autocomplete="off" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PrecoTexto" class="form-label fw-bold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">R$</span>
                            <input asp-for="PrecoTexto" class="form-control" placeholder="Ex: 299,90" autocomplete="off" />
                        </div>
                        <span asp-validation-for="PrecoTexto" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="Status" class="form-check-label fw-semibold text-secondary">Produto ativo no catálogo</label>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-arrow-left me-1"></i> Voltar
                        </a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Salvar Produto
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}