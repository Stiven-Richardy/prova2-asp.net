@model Prova2.Web.Models.ProdutoFormViewModel

@{
    ViewData["Title"] = "Editar Produto";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0" style="border-top: 4px solid #0A3D62 !important;">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-0 fw-bold" style="color: #0A3D62;">
                        <i class="bi bi-pencil-square me-2"></i> Editar Produto #@Model.Id
                    </h5>
                    <span class="text-muted small">As alterações serão registradas sob autoria de <strong>@User.Identity?.Name</strong>.</span>
                </div>
                <span class="badge bg-light text-dark border">ID #@Model.Id</span>
            </div>

            <div class="card-body p-4">
                @if (ViewData["AuditoriaCadastro"] != null)
                {
                    <div class="alert alert-light border small mb-4">
                        <div><strong>Cadastrado por:</strong> @ViewData["AuditoriaCadastro"]</div>
                        <div><strong>Última alteração:</strong> @ViewData["AuditoriaUpdate"]</div>
                    </div>
                }

                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 mb-3"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label fw-bold text-secondary"></label>
                        <input asp-for="Nome" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Nome" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PrecoTexto" class="form-label fw-bold text-secondary"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">R$</span>
                            <input asp-for="PrecoTexto" class="form-control" autocomplete="off" />
                        </div>
                        <span asp-validation-for="PrecoTexto" class="text-danger small"></span>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="Status" class="form-check-input" type="checkbox" role="switch" />
                        <label asp-for="Status" class="form-check-label fw-semibold text-secondary">Produto ativo no catálogo</label>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Salvar Alterações
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}