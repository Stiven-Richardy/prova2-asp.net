@model Prova2.Web.Models.ProdutosIndexViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Catálogo de Produtos";
    var cultura = new CultureInfo("pt-BR");
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0A3D62 !important;">
            <div class="card-body py-3">
                <span class="text-muted small d-block">Total de Produtos</span>
                <h4 class="fw-bold mb-0" style="color: #0A3D62;">@Model.TotalProdutos</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
            <div class="card-body py-3">
                <span class="text-muted small d-block">Produtos Ativos</span>
                <h4 class="fw-bold text-success mb-0">@Model.TotalAtivos</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-body py-3">
                <span class="text-muted small d-block">Produtos Inativos</span>
                <h4 class="fw-bold text-danger mb-0">@Model.TotalInativos</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body py-3">
                <span class="text-muted small d-block">Soma dos Ativos</span>
                <h4 class="fw-bold text-primary mb-0">@Model.ValorTotalAtivos.ToString("C2", cultura)</h4>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
            <div>
                <h5 class="card-title mb-1 text-secondary fw-bold">Gestão de Produtos</h5>
                <p class="text-muted small mb-0">Controle de catálogo, status de disponibilidade e rastreabilidade de alterações.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="ExportarCsv"
                   asp-route-busca="@Model.BuscaAtual"
                   asp-route-filtroStatus="@Model.StatusAtual"
                   download
                   class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3 py-2">
                    <i class="bi bi-file-earmark-spreadsheet"></i>
                    <span>Exportar CSV</span>
                </a>
                <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 py-2">
                    <i class="bi bi-plus-lg"></i>
                    <span>Novo Produto</span>
                </a>
            </div>
        </div>

        <form asp-action="Index" method="get" class="row g-2 mb-4">
            <div class="col-md-6">
                <input type="text" name="busca" value="@Model.BuscaAtual" class="form-control" placeholder="Filtrar produto por nome..." />
            </div>
            <div class="col-md-3">
                <select name="filtroStatus" class="form-select">
                    <option value="todos" selected="@(Model.StatusAtual == "todos")">Todos os status</option>
                    <option value="ativos" selected="@(Model.StatusAtual == "ativos")">Somente Ativos</option>
                    <option value="inativos" selected="@(Model.StatusAtual == "inativos")">Somente Inativos</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th>ID</th>
                        <th>Produto</th>
                        <th>Preço</th>
                        <th>Status</th>
                        <th>Cadastrado por</th>
                        <th>Última Alteração</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Produtos.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Nenhum produto encontrado.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Produtos)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.Id</td>
                                <td class="fw-semibold text-dark">@item.Nome</td>
                                <td class="fw-bold text-dark">@item.Preco.ToString("C2", cultura)</td>
                                <td>
                                    @if (item.Status)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i> Ativo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-2 py-1">
                                            <i class="bi bi-slash-circle me-1"></i> Inativo
                                        </span>
                                    }
                                </td>
                                <td class="small">
                                    <span class="fw-semibold text-dark">@item.NomeUsuarioCadastro</span>
                                    <span class="text-muted d-block">ID #@item.IdUsuarioCadastro</span>
                                </td>
                                <td class="small">
                                    @if (item.IdUsuarioUpdate.HasValue)
                                    {
                                        <span class="fw-semibold text-primary">@item.NomeUsuarioUpdate</span>
                                        <span class="text-muted d-block">ID #@item.IdUsuarioUpdate</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Sem alterações</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <form asp-action="AlternarStatus" asp-route-id="@item.Id" method="post" class="m-0">
                                            <button type="submit"
                                                    class="btn btn-sm @(item.Status ? "btn-outline-warning" : "btn-outline-success")"
                                                    title="@(item.Status ? "Inativar produto" : "Ativar produto")">
                                                <i class="bi @(item.Status ? "bi-toggle-on" : "bi-toggle-off")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Visualizar detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Editar produto">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir produto">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>